{
  "name": "goagent-runtime-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run gen:reference && vuepress dev src",
    "gen:reference": "node scripts/gen_reference_pages.mjs",
    "check:reference": "node scripts/gen_reference_pages.mjs --check",
    "check:links": "node scripts/check-links.mjs",
    "build": "npm run gen:reference && npm run check:links && vuepress build src",
    "build:debug": "vuepress build src --debug"
  },
  "devDependencies": {
    "@vuepress/bundler-vite": "^2.0.0-rc.32",
    "@vuepress/theme-default": "2.0.0-rc.140",
    "mermaid": "^11.6.0",
    "sass": "^1.108.2",
    "sass-embedded": "^1.108.2",
    "vuepress": "2.0.0-rc.32"
  }
}
